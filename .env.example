# Copy to .env and adjust as needed. Each service also reads these from its
# own environment — this file just documents every variable used across the
# stack in one place.

# --- Redis Streams (shared event bus) ---
REDIS_URL=redis://localhost:6379
REDIS_ADDR=localhost:6379

# --- order-service (Go) ---
ORDER_SERVICE_CONSUMER_GROUP=order-service-group

# --- payment-service (Node/Express) ---
PAYMENT_SERVICE_PORT=3001

# --- bib-service (Node/Express) ---
BIB_SERVICE_PORT=3002

# --- saga-orchestrator (Node/Express) ---
SAGA_ORCHESTRATOR_PORT=3000
DATABASE_URL=postgres://race_flow:race_flow@localhost:5432/race_flow
